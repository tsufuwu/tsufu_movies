# ==============================================================================
# CẤU HÌNH KẾT NỐI API BACKEND
# ==============================================================================
# Mục đích: Địa chỉ của Backend Server (FastAPI). 
# Ở môi trường phát triển (Local), Vite sẽ dùng biến này để điều hướng (proxy)
# các lệnh gọi API từ Frontend sang Backend, giúp tránh lỗi CORS.
# Bắt buộc: Không (Optional) - Nếu không truyền sẽ lấy mặc định ở dưới.
# Mặc định: http://localhost:8000
VITE_API_PROXY_TARGET=http://localhost:8000
