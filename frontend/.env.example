# ==============================================================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG FRONTEND (REACT + VITE & NGINX DOCKER)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. MÔI TRƯỜNG PHÁT TRIỂN LOCAL (VITE DEV SERVER)
# ------------------------------------------------------------------------------

# Địa chỉ máy chủ Backend (FastAPI) để Vite điều hướng (proxy) các request /api/...
# Giúp tránh triệt để lỗi CORS khi chạy local (frontend:5173 -> backend:8000).
# Mặc định: http://localhost:8000
VITE_API_PROXY_TARGET=http://localhost:8000

# Base URL trực tiếp của API (nếu muốn gọi trực tiếp không qua proxy).
# Khuyến nghị: Để trống "" để ứng dụng gọi relative path (/api/...) 
# tận dụng Reverse Proxy của Nginx trong Docker hoặc Vite proxy ở Local.
# Mặc định: (trống)
VITE_API_BASE_URL=

# Port chạy Vite dev server ở máy local.
# Mặc định: 5173
VITE_PORT=5173

# ------------------------------------------------------------------------------
# 2. MÔI TRƯỜNG DOCKER & NGINX REVERSE PROXY (PRODUCTION)
# ------------------------------------------------------------------------------
# Các biến này được truyền vào container Nginx qua Docker CLI hoặc docker-compose.yml:

# Port máy chủ Nginx lắng nghe bên trong container.
# Mặc định: 80
APP_PORT=80

# Địa chỉ mạng nội bộ Docker của container Backend để Nginx chuyển tiếp (proxy_pass).
# Mặc định: http://backend:8000
BACKEND_URL=http://backend:8000

# Bộ lọc envsubst để Nginx thay thế biến môi trường vào template default.conf.template.
# Mặc định: APP_PORT|BACKEND_URL
NGINX_ENVSUBST_FILTER=APP_PORT|BACKEND_URL
