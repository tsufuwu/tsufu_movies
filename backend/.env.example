# ==============================================================================
# CẤU HÌNH API (Bắt buộc)
# ==============================================================================
# Mục đích: Địa chỉ gốc của API cung cấp dữ liệu phim. 
# Bắt buộc: Có (Essential)
# Mặc định: https://phim.nguonc.com/api
NGUONC_BASE_URL=https://phim.nguonc.com/api

# ==============================================================================
# CẤU HÌNH BỘ NHỚ ĐỆM - CACHE (Tùy chọn)
# ==============================================================================
# Mục đích: Thời gian lưu trữ dữ liệu trong bộ nhớ đệm (tính bằng giây) 
# để giảm tải cho máy chủ API nguồn, giúp ứng dụng phản hồi nhanh hơn.
# Bắt buộc: Không (Optional) - Nếu không truyền sẽ lấy mặc định.

# Mặc định: 300 giây (5 phút) - Dùng cho trang danh sách phim
CACHE_TTL_LIST=300

# Mặc định: 1800 giây (30 phút) - Dùng cho trang chi tiết một bộ phim
CACHE_TTL_DETAIL=1800

# Mặc định: 180 giây (3 phút) - Dùng cho kết quả tìm kiếm phim
CACHE_TTL_SEARCH=180

# ==============================================================================
# CẤU HÌNH BẢO MẬT & CROSS-ORIGIN (Tùy chọn)
# ==============================================================================
# Mục đích: Danh sách các tên miền (Frontend) được phép gọi API tới Backend này. 
# Ngăn chặn các trang web lạ đánh cắp dữ liệu hoặc gọi API trộm.
# Các tên miền cách nhau bằng dấu phẩy.
# Bắt buộc: Không (Optional)
# Mặc định: http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# ==============================================================================
# CẤU HÌNH TRÌNH PHÁT VIDEO & PROXY (Tùy chọn)
# ==============================================================================
# Mục đích: Địa chỉ gốc của máy chủ phát video (để bypass quảng cáo).
# Bắt buộc: Không (Optional)
# Mặc định: https://streamc.xyz
STREAMC_BASE=https://streamc.xyz

# Mục đích: Thời gian chờ tối đa (giây) khi backend gọi sang server phim/video.
# Tránh trường hợp server phim bị sập làm treo luôn backend của mình.
# Bắt buộc: Không (Optional)
# Mặc định: 15.0
HTTP_TIMEOUT=15.0

# Mục đích: Danh sách các tên miền được phép proxy qua backend. 
# Ngăn chặn hacker dùng backend của mình làm trạm trung chuyển (open proxy).
# Bắt buộc: Không (Optional)
# Mặc định: streamc.xyz
ALLOWED_PROXY_DOMAINS=streamc.xyz

# ==============================================================================
# BẢO MẬT CHỐNG BOT CÀO & CHỐNG LEECH BĂNG THÔNG (Security Hardening)
# ==============================================================================
# 1. Ephemeral Session Token:
# Khóa bí mật dùng để sinh và kiểm tra chữ ký session token (không cần login)
SESSION_SECRET=tsufu-session-secret-key-default-change-me
# Thời gian hết hạn của session (giây) - Mặc định 14400 (4 tiếng)
SESSION_TTL=14400
# Bật/tắt bắt buộc session cho API (true / false)
ENABLE_SESSION_CHECK=true

# 2. Signed Stream URLs (Ký chữ ký bảo vệ link stream/proxy):
# Khóa bí mật dùng để tạo chữ ký HMAC cho link stream/proxy
STREAM_SECRET_KEY=tsufu-stream-hmac-secret-key-default-change-me
# Thời gian hết hạn của link stream đã ký (giây) - Mặc định 7200 (2 tiếng)
STREAM_TOKEN_TTL=7200
# Bật/tắt chữ ký link stream (true / false)
ENABLE_STREAM_SIGNATURE=true

# 3. Chống nhúng trộm & leech cross-site (Sec-Fetch-Site & Referer check):
# Chặn các trang web khác nhúng proxy stream của bạn sang web của họ
ENFORCE_REFERER_CHECK=true

# 4. Bẫy Bot Honeypot:
# Tự động vô hiệu hóa và trả kết quả rỗng khi phát hiện bot điền vào input ẩn
ENABLE_HONEYPOT=true
